# ============================================================
# Configuración de la API Banco Demo (copiar a .env)
# TODOS LOS DATOS SON FICTICIOS - proyecto académico
# ============================================================

# Base de datos (SQLite por defecto; para PostgreSQL:
# postgresql+psycopg://usuario:clave@localhost:5432/banco_demo)
DATABASE_URL=sqlite:///./banco_demo.db

# Secreto para firmar los JWT (genere uno largo y aleatorio)
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# Orígenes CORS permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redes permitidas en notación CIDR separadas por coma (vacío = permitir todo)
# Ejemplo laboratorio: 127.0.0.1/32,192.168.0.0/16,10.0.0.0/8
ALLOWED_NETWORKS=

# Swagger (/docs) y ReDoc (/redoc)
DOCS_ENABLED=true

# Límites de peticiones (sintaxis slowapi: N/second|minute|hour)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute
